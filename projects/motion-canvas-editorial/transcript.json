[
{"start":0.033333,"end":0.933333,"text":"हम अपने"},
{"start":0.933333,"end":2.266667,"text":"पापकर्म से"},
{"start":2.266667,"end":4.666667,"text":"एक विष्ठा के कीड़े भी बन जाते हैं ना?"},
{"start":4.666667,"end":5.466667,"text":"तब भी भगवान"},
{"start":5.466667,"end":6.566667,"text":"इतने दयालु हैं,"},
{"start":6.566667,"end":8,"text":"इतने परम दयालु हैं"},
{"start":8,"end":9.6,"text":"कि वो हमें छोड़ते नहीं हैं।"},
{"start":9.6,"end":12.3,"text":"भगवान सदा सदैव हमारे साथ रहते हैं"},
{"start":12.3,"end":14.266667,"text":"और उसके बाद जैसे ही हमें"},
{"start":14.266667,"end":15.866667,"text":"इंसान की योनि मिलती है,"},
{"start":15.866667,"end":16.366667,"text":"जैसे ही हम"},
{"start":16.366667,"end":17.533333,"text":"मनुष्य बनते हैं"},
{"start":17.533333,"end":18.366667,"text":"तो भैया सबसे पहले"},
{"start":18.366667,"end":20.1,"text":"हम भगवान को भूल जाते हैं।"},
{"start":20.1,"end":22.733333,"text":"उसके बाद फिर दुख से बिलबिलाते हैं कि भैया"},
{"start":22.733333,"end":24.166667,"text":"भगवान इतना दुख क्यों दे रहा है।"}
]
